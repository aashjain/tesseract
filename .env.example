# Canonical origin. Used for metadata, social cards and absolute URLs.
NEXT_PUBLIC_SITE_URL=https://agdesigns.example

# --- CMS (optional) --------------------------------------------------------
# Leave unset to use the typed local fixtures in src/lib/content/fixtures.ts.
# Setting these without installing the Sanity adapter fails loudly on purpose —
# see "Content" in README.md.
# NEXT_PUBLIC_SANITY_PROJECT_ID=
# NEXT_PUBLIC_SANITY_DATASET=production
# SANITY_API_READ_TOKEN=

# --- Contact ---------------------------------------------------------------
# Where enquiries are POSTed as JSON. UNSET BY DEFAULT: the form validates and
# confirms, but nothing is delivered anywhere. Must be set before launch.
# CONTACT_WEBHOOK_URL=

# --- Monitoring (optional) -------------------------------------------------
# Captures renderer failures and WebGL context loss. Form values are never sent.
# NEXT_PUBLIC_SENTRY_DSN=
